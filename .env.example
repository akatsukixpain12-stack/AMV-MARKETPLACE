# Flask Backend
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
DATABASE_URL=sqlite:///vortex.db

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
